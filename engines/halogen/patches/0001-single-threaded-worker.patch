@@ -26,7 +29,24 @@ namespace NN
 
 #undef INCBIN_ALIGNMENT
 #define INCBIN_ALIGNMENT 64
+#ifdef __EMSCRIPTEN__
+// Zeist: the worker writes the network into the in-memory file system before
+// static initialization, so it is read here instead of embedded with incbin.
+static const unsigned char* zeist_read_net()
+{
+    void* buf = std::aligned_alloc(64, (sizeof(network) + 63) / 64 * 64);
+    FILE* f = std::fopen("/" EVALFILE, "rb");
+    if (!f || std::fread(buf, 1, sizeof(network), f) != sizeof(network))
+        std::cout << "info string could not read network " EVALFILE << std::endl;
+    if (f)
+        std::fclose(f);
+    return static_cast<const unsigned char*>(buf);
+}
+static const unsigned char* gNetData = zeist_read_net();
+static const unsigned int gNetSize = sizeof(network);
+#else
 INCBIN(Net, EVALFILE);
+#endif
 
 const network& net = reinterpret_cast<const network&>(*gNetData);
 
