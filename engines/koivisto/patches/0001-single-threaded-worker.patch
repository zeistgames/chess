 void nn::init() {
+#ifdef __EMSCRIPTEN__
+    if (!gEvalData) {
+        FILE* f = std::fopen("/" EVALFILE, "rb");
+        if (f) {
+            std::fseek(f, 0, SEEK_END);
+            zeistEvalBytes.resize(std::ftell(f));
+            std::fseek(f, 0, SEEK_SET);
+            if (std::fread(zeistEvalBytes.data(), 1, zeistEvalBytes.size(), f) != zeistEvalBytes.size())
+                zeistEvalBytes.clear();
+            std::fclose(f);
+        }
+        if (zeistEvalBytes.empty())
+            std::cout << "info string could not read network " EVALFILE << std::endl;
+        gEvalData = zeistEvalBytes.data();
+    }
+#endif
     int memoryIndex = 0;
